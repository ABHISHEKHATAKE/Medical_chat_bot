PORT=5000
MONGODB_URI=mongodb://localhost:27017/medical_ai  # reuse same cluster as Python RAG; do not point to traveloop without /medical_ai suffix
MONGODB_DATABASE=medical_ai
AI_SERVICE_URL=http://localhost:8000
# NOTE: node reads this file at startup. After editing, restart the backend.
# Without a real sk_ key the API accepts the dev bypass header instead of Clerk tokens.
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...
FRONTEND_URL=http://localhost:5173
NODE_ENV=development
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MAX_IMAGE_SIZE_MB=5
